# ================= 基础 =================
# 生产必须改成随机长字符串：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# 生产站点域名（同时被 nginx 模板用：证书路径 live/<DOMAIN>/）
DOMAIN=example.com

# 本地开发 true；生产必须 false
DJANGO_DEBUG=true

# 生产示例：DJANGO_ALLOWED_HOSTS=example.com,www.example.com,web,localhost
#（web 是 docker-compose 里 web 容器的服务名）
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 生产示例：DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
#DJANGO_CSRF_TRUSTED_ORIGINS=

# ================= 数据库 =================
# 本地开发不填 DB_* => 默认 SQLite（零配置）
# 生产：DB_ENGINE=mysql，HOST 用 compose 服务名 db
DB_ENGINE=sqlite
#DB_ENGINE=mysql
#DB_HOST=db
#DB_PORT=3306
#DB_NAME=personal_site
#DB_USER=site
#DB_PASSWORD=change-me-in-production

# ================= GLM 大模型（OpenAI 兼容接口） =================
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 默认模型（2026-11 实测免费：glm-5.3-flash / glm-5.3-flashx；其余 glm-5.x 需充值）
LLM_MODEL=glm-5.3-flash
# 前端“模型”下拉可选范围（逗号分隔，留默认即可）
LLM_MODELS=glm-5.3-flash,glm-5.3-flashx
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Xray 代理（VLESS-WS 经 Cloudflare 中转的入口路径；nginx 模板要用，必填）
# 在 VPS 上随机生成：XRAY_WS_PATH=/ws-$(openssl rand -hex 6)
# ---------------------------------------------------------------------------
XRAY_WS_PATH=/ws-change-me

# ================= Uvicorn（生产容器） =================
# 1GB 内存建议 1
UVICORN_WORKERS=1
