# 站点 nginx 配置模板。
# 由官方 nginx 镜像入口在启动时用 envsubst 处理：
#   /etc/nginx/templates/default.conf.template → /etc/nginx/conf.d/default.conf
# ${DOMAIN} / ${DOMAIN_OLD} 来自 docker-compose.yml 的 environment（= .env 里同名变量）。
# DOMAIN_OLD 可选：多域名共存时填旧域名（一张证书含两个 SAN）；留空则只有 DOMAIN。
# nginx 自身的变量（$host/$remote_addr 等）不在容器环境里，不会被误替换。

# ---------------------------------------------------------- 80：ACME 验证 + 跳转
server {
    listen 80;
    server_name ${DOMAIN} ${DOMAIN_OLD};

    client_max_body_size 12m;

    # Let's Encrypt HTTP-01 验证路径（webroot 模式续期也走这里）
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    #其余一律 301 → https
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------- 443：https 主站
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} ${DOMAIN_OLD};

    # 证书由 certbot 写入共享卷 letsencrypt；容器启动时须已签发
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols     TLSv1.2 TLSv1.3;
    ssl_ciphers       HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:5m;

    keepalive_timeout 65;
    client_max_body_size 12m;

    # 压缩文本类响应（nginx 直出的静态已带缓存头）
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # ---------------- 静态文件（collectstatic 产物，nginx 直出） ----------------
    location /static/ {
        alias /usr/share/nginx/static/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ---------------- 媒体文件（用户上传图片，nginx 直出） ----------------
    location /media/ {
        alias /usr/share/nginx/media/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ---------------- SSE 流式路径（/chat 发消息接口） ----------------
    # proxy_buffering off + read_timeout 300s：逐字转发 GLM 流式响应
    location ~ ^/chat/api/conversations/(\d+)/messages/stream/ {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering  off;
        proxy_cache      off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Connection "";
    }

    # ---------------- VLESS-WS 代理入口（经 Cloudflare 中转） ----------------
    # 只有带 WebSocket 升级头的请求才转发给 xray，其余一律 404（防路径扫描）
    location ${XRAY_WS_PATH} {
        if ($http_upgrade !~* ^websocket$) { return 404; }
        # 用 Docker 内嵌 DNS 动态解析 xray（xray 容器重建换 IP 也不用动 nginx）
        resolver 127.0.0.11 valid=10s;
        set $xray_backend "xray:10086";
        proxy_pass http://$xray_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade  $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host     $host;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---------------- 其余全部反代 Django（admin / blog / ledger …） ----------------
    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
    }
}
